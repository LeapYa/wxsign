# 复制为 brands/<slug>.env 后填。⚠️ 含凭证，别提交（已由 .gitignore 忽略）。
# 大部分字段由 wxident.js 自动写入，只有 GAMEID 通常需要人工从 --discover 的结果里抄。

# ── 静态（与 brands.json 对应，方便脚本自检）──
WX_APPID=
BRAND_NAME=

# ── 身份（wxident.js / wxrefresh.js 自动写）──
WX_MPID=            # gh_ 开头的租户 id
WX_OPENID=          # 该账号在这个品牌下的 openId（应等于 token 的 sub）
WX_UNIONID=
WX_GCID=            # 分片键，可选
WX_TOKEN=           # 短效 JWT，脚本自动刷新

# ── 活动 ──
WX_GAMEID=          # 活动 id；lot 型号可用 `wxsign.py <slug> --discover` 从活动列表里抄
WX_THIRDSHOPID=     # 门店 id，可选

# ── 会员（可留空，脚本会用 /api/member/single 自动补）──
WX_MEMBERID=
WX_CARDID=
WX_CARDNO=

# ── 注册（账号还不是该品牌会员时；也可以直接在小程序里走一次手机号授权）──
# WX_REGISTER_PHONE=13800000000
